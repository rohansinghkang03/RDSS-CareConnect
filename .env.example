DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
VERIFY_TOKEN=
# Comma-separated international numbers, including country codes. No spaces within a number.
ADMIN_PHONE_NUMBERS=
ADMIN_PIN=
# Set separately only during an approved migration:
CARECONNECT_MIGRATION_URL=
# Enable only after phase3_manage.py preflight and migrate --apply succeed.
REPORTING_ENABLED=false
RETENTION_ENABLED=false
MATCH_CHAT_ENABLED=false
# Optional comma-separated controlled numbers; both participants must be listed.
MATCH_CHAT_TEST_NUMBERS=
# Only for an explicitly approved test target with no caregiver traffic.
CARECONNECT_TEST_DATABASE=false

# Operational alerts require recipient opt-in; closed-window alerts wait for their next visit.
NOTIFICATIONS_ENABLED=false

# Enable only after connection_request_v2_schema.sql is applied and verified.
CONNECTION_REQUEST_V2_ENABLED=false

# Shared basic profiles and paged matching: migrate basic_profile_schema.sql first.
# Requires CONNECTION_REQUEST_V2_ENABLED=true.
BASIC_PROFILE_ENABLED=false
